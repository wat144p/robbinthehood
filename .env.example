# Copy to .env (which is gitignored) and fill in.
# Real environment variables always take precedence over this file, so CI
# secrets are never shadowed by a stale local copy.

# --- eBay Browse API (stage 2) ---------------------------------------------
# Free. developer.ebay.com -> register -> create a PRODUCTION keyset.
# The Sandbox keyset returns fake inventory, so make sure you copy the
# production App ID / Cert ID.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Best Buy Developer API (stage 4) ---------------------------------------
# Free, issued instantly. developer.bestbuy.com
# Best Buy open-box is where the best OLED + 5070 Ti pricing has appeared.
# Optional. Their signup needs a US/Canada phone number; if you cannot get
# one, skip it — Best Buy open-box stock is reachable through their eBay
# storefront instead (sources.ebay.storefronts in config.yaml).
BESTBUY_API_KEY=

# --- Reddit (stage 4) -------------------------------------------------------
# Required as of 2026-08: the unauthenticated .json endpoint now returns 403.
# Free, no approval. reddit.com/prefs/apps -> "create another app" -> SCRIPT.
# Redirect URI can be http://localhost (this grant never uses it).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Notification -----------------------------------------------------------
# Discord: server -> a channel -> Edit Channel -> Integrations -> Webhooks ->
# New Webhook -> Copy Webhook URL. Alerts arrive as messages in THAT channel.
DISCORD_WEBHOOK_URL=

# ntfy (phone push): any long RANDOM string, then subscribe to it in the
# ntfy app. Anyone who knows the topic can read AND post to it, so make it
# unguessable — not "laptop-deals".
NTFY_TOPIC=

# Email. Gmail needs an APP PASSWORD, not your Google password:
#   2FA on -> myaccount.google.com/apppasswords -> generate.
# Port 587 = STARTTLS, 465 = implicit TLS. EMAIL_TO accepts a comma list.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# EMAIL_FROM=          # optional; defaults to SMTP_USER
